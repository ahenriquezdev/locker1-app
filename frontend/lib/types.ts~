export namespace ApiResponse {
  export interface FieldError {
    field: string;
    message: string;
  }

  export interface Response<T = null> {
    success: boolean;
    message: string;
    data?: T;
    errors?: FieldError[];
    display?: boolean;
  }
}

export interface PasswordFormProps {
  formData?: PasswordModel;
  currentPassword?: PasswordModel;
  onActionComplete?(): void | Promise<void>;
}

export type ToastType = "success" | "info" | "warning" | "error";

export interface ToastProps {
  badge: ToastType;
  title: string;
  message: string;
  errors?: string[];
  duration?: number;
}

export type PasswordSearchParams = {
  searchParams: { [key: string]: string | string[] | undefined };
};

export type PasswordModel = {
  id: string;
  userId?: string | null;
  service: string;
  url: string;
  username: string;
  password: string;
  score: number;
  strength: string;
  createdAt: string;
  updatedAt: string;
  isShared?: boolean;
  sharedWithUser?: boolean;
  sharedFromGroup?: string | null;
};
