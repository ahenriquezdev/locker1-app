
import { getPasswords } from "@/lib/actions/passwordActions";
import PasswordTable from "./password-table";

interface PasswordTableDataProps {
  token: string;
  onViewPassword: (password: any) => void;
  selectedCategory: "propias" | "externas";
}

export default async function PasswordTableData({
  token,
  onViewPassword,
  selectedCategory,
}: PasswordTableDataProps) {
  const passwordsResponse = await getPasswords(token);

  if (passwordsResponse.success && passwordsResponse.data) {
    return (
      <PasswordTable
        passwordsData={passwordsResponse.data}
        onViewPassword={onViewPassword}
        selectedCategory={selectedCategory}
      />
    );
  } else {
    return (
      <div>
        {passwordsResponse.message || "Error al cargar las contraseñas."}
      </div>
    );
  }
}
