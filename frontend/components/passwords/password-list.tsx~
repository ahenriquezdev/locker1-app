import React from "react";
import SearchBar from "@/components/passwords/search-bar";
import GroupSelector from "@/components/passwords/group-selector";
import PasswordTable from "@/components/passwords/password-table";
// import Pagination from "./Pagination";
import { useSearchParams } from "next/navigation";
import { getPasswords } from "@/lib/actions/passwordActions";

interface PasswordListProps {
  passwords: any[];
  selectedCategory: string | null;
  searchTerm: string;
  selectedGroup: string | null;
  currentPage: number;
  onViewPassword: (password: any) => void;
  onEditPassword: (password: any) => void;
}

export default async function PasswordList({
  onViewPassword,
  onEditPassword,
}: PasswordListProps) {
  const searchParams = useSearchParams();

  const selectedCategory = searchParams.get("category") || null;
  const searchTerm = searchParams.get("search") || "";
  const selectedGroup = searchParams.get("group") || null;
  const currentPage = parseInt(searchParams.get("page") || "1");

  const response = await getPasswords();

  const passwords = response || [];


  return (
    <div className="grid gap-8">
      <div className="flex items-center space-x-2">
        <SearchBar />
        {/*<GroupSelector groups={groups} />*/}
      </div>

      <PasswordTable
        passwords={passwords}
        category={""}
        onViewPassword={onViewPassword}
        onEditPassword={onEditPassword}
      />
      {/*<Pagination currentPage={currentPage} totalPages={totalPages} />*/}
    </div>
  );
}
